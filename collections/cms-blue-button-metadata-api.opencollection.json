{
  "opencollection": "1.0.0",
  "info": {
    "name": "CMS Blue Button 2.0 Coverage Metadata API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.bluebutton.cms.gov/v2/o/authorize/",
      "accessTokenUrl": "https://api.bluebutton.cms.gov/v2/o/token/",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Metadata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve the FHIR capability statement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bluebutton.cms.gov/v2/fhir/metadata"
          },
          "docs": "Returns the server CapabilityStatement (FHIR 4.0.1) describing the supported resources, interactions, and search parameters. Does not require authorization."
        }
      ]
    }
  ],
  "bundled": true
}